        ],
        "signoffFields": "default"
      },
      {
        "id": "flashing", "label": "Flashing", "required": true,
        "fields": [
          { "key": "sealant", "label": "Sealant type", "type": "text", "placeholder": "e.g. polyurethane" }
        ],
        "signoffFields": "default"
      },
      {
        "id": "leaktest", "label": "Leak test", "requiredIf": ["Leak", "patch", "Skylight"],
